---
import { src, srcset, pick, detailLine } from "../lib/data.js";
interface Props {
  item: any;
  sizes: string;
  alt?: string;
  altZh?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "auto";
  class?: string;
  lightbox?: boolean;
  index?: number;
  title?: string;
  href?: string;
  titleZh?: string;
  place?: string | null;
  placeZh?: string | null;
}
const { item, sizes, alt = item.alt || "", altZh, loading = "lazy", fetchpriority = "auto", class: cls, lightbox = false, index, title, titleZh, href, place = item.place, placeZh } = Astro.props;
const fallback = pick(item, 1200);
const data = lightbox ? {
  "data-lb-id": item.id,
  "data-lb-sizes": item.sizes.join(","),
  "data-lb-w": item.w,
  "data-lb-h": item.h,
  "data-lb-index": index,
  "data-lb-exif": detailLine(item, place),
  "data-lb-exif-zh": placeZh && placeZh !== place ? detailLine(item, placeZh) : undefined,
  "data-lb-title": title,
  "data-lb-title-zh": titleZh && titleZh !== title ? titleZh : undefined,
  "data-lb-href": href,
} : {};
---
<img
  src={src(item, fallback)}
  srcset={srcset(item)}
  sizes={sizes}
  width={item.w}
  height={item.h}
  alt={alt}
  data-zh-alt={altZh && altZh !== alt ? altZh : undefined}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
  style={`--ar:${(item.w / item.h).toFixed(4)}`}
  class={cls}
  {...data}
/>
