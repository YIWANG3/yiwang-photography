---
import Base from "../layouts/Base.astro";
import Pic from "../components/Pic.astro";
import L from "../components/L.astro";
import Lightbox from "../components/Lightbox.astro";
import { allGalleries, galleries, exposure, yearOf } from "../lib/data.js";
import { tr, placeOf } from "../i18n/ui.js";

export function getStaticPaths() {
  return allGalleries.map((g) => ({ params: { slug: g.slug }, props: { gallery: g } }));
}
const { gallery: g } = Astro.props;
const visible = galleries;
const pos = visible.findIndex((x) => x.slug === g.slug);
const prev = pos > 0 ? visible[pos - 1] : null;
const next = pos >= 0 && pos < visible.length - 1 ? visible[pos + 1] : null;

// Two portraits in a row share a row; everything else stands alone.
const rows: Array<{ kind: "one" | "pair"; items: any[] }> = [];
for (let i = 0; i < g.items.length; i++) {
  const a = g.items[i], b = g.items[i + 1];
  if (a.shape === "portrait" && b && b.shape === "portrait") { rows.push({ kind: "pair", items: [a, b] }); i++; }
  else rows.push({ kind: "one", items: [a] });
}
const pad = (n: number) => String(n).padStart(2, "0");
const indexOf = (it: any) => g.items.indexOf(it);
const caption = (it: any) => [exposure(it.exif)].filter(Boolean);
const zhTitle = tr(g, "title", "zh");
const description = g.description, zhDescription = tr(g, "description", "zh");
const year = g.year ?? yearOf(g.items);
const pic = (it: any) => ({ item: it, lightbox: true, index: indexOf(it), title: g.title, titleZh: zhTitle, place: it.place, placeZh: placeOf(it, g, "zh") });
---
<Base title={g.title} titleZh={zhTitle} tone={g.tone} current={g.slug} description={description || `${g.title}, a series of ${g.count} photographs by Yi Wang.`}>
  <header class="series-head">
    <h1><L en={g.title} zh={zhTitle} /></h1>
    <p class="meta"><L en={`Series of ${g.count}`} zh={`共 ${g.count} 张`} />{year ? ` · ${year}` : ""}</p>
    {g.gear.length > 0 && <p class="gear">{g.gear.map((s) => <span>{s}</span>)}</p>}
    {description && <p class="desc"><L en={description} zh={zhDescription} /></p>}
  </header>

  <div class="flow" id="flow">
    {rows.map((row) =>
      row.kind === "pair" ? (
        <div class="pair">
          {row.items.map((it) => (
            <figure class="fig">
              <Pic {...pic(it)} sizes="(max-width: 640px) 100vw, min(50vw, 700px)" loading={indexOf(it) < 2 ? "eager" : "lazy"} />
              <figcaption><span class="n">{pad(indexOf(it) + 1)} / {pad(g.count)}</span>{caption(it).map((s) => <span>{s}</span>)}</figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <figure class="fig">
          <Pic {...pic(row.items[0])} sizes="(max-width: 900px) 100vw, min(calc(100vw - 330px), 1400px)" loading={indexOf(row.items[0]) < 2 ? "eager" : "lazy"} fetchpriority={indexOf(row.items[0]) === 0 ? "high" : "auto"} />
          <figcaption><span class="n">{pad(indexOf(row.items[0]) + 1)} / {pad(g.count)}</span>{caption(row.items[0]).map((s) => <span>{s}</span>)}</figcaption>
        </figure>
      )
    )}
  </div>

  <nav class="series-foot" aria-label="Series" data-zh-aria-label="系列">
    <a class="prev" href={prev ? `/${prev.slug}/` : "/"}><span><span class="k"><L en="Previous" zh="上一组" /></span><span>{prev ? <L en={prev.title} zh={tr(prev, "title", "zh")} /> : <L en="All series" zh="全部系列" />}</span></span></a>
    <a class="next" href={next ? `/${next.slug}/` : "/"}><span><span class="k"><L en="Next" zh="下一组" /></span><span>{next ? <L en={next.title} zh={tr(next, "title", "zh")} /> : <L en="All series" zh="全部系列" />}</span></span></a>
  </nav>

  <Lightbox />
  <script>
    import "../scripts/lightbox.js";
  </script>
</Base>
