---
import Base from "../layouts/Base.astro";
import Pic from "../components/Pic.astro";
import { galleries, itemById, yearOf } from "../lib/data.js";
---
<Base current="work">
  <div class="covers">
    {galleries.map((g, i) => {
      const cover = itemById(g.cover) ?? g.items[0];
      return (
        <a class="cover" href={`/${g.slug}/`}>
          <div class="ph">
            <Pic item={cover} sizes="(max-width: 520px) 100vw, (max-width: 1180px) 50vw, 36vw" alt={g.title} loading={i < 3 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} />
          </div>
          <div class="t"><span class="name">{g.title}</span><span class="n">{[g.count, g.year ?? yearOf(g.items)].filter(Boolean).join(" · ")}</span></div>
        </a>
      );
    })}
  </div>
</Base>
