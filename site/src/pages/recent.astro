---
import Base from "../layouts/Base.astro";
import Pic from "../components/Pic.astro";
import Lightbox from "../components/Lightbox.astro";
import { recentIds, itemById, site } from "../lib/data.js";
const items = recentIds.map(itemById).filter(Boolean);
---
<Base title="Recent" current="recent">
  <h1 class="page-title">Recent</h1>
  <div class="grid">
    {items.map((it, i) => (
      <div class="cell">
        <Pic item={it} sizes="(max-width: 560px) 50vw, (max-width: 900px) 33vw, 25vw" alt={it.gallery.title} loading={i < 8 ? "eager" : "lazy"} lightbox index={i} title={it.gallery.title} href={`/${it.gallery.slug}/`} />
      </div>
    ))}
  </div>
  {site.exif_mock && <p class="prose m" style="margin-top: 24px">Prototype note: capture dates are not available yet, so this page shows the first photographs of each series instead of the newest.</p>}

  <Lightbox />
  <script>
    import "../scripts/lightbox.js";
  </script>
</Base>
