# Copy to .env (gitignored). Read by publisher/bin/publish.mjs for sync-images and deploy.

# Cloudflare R2: bucket that holds <id>/<w>.webp. Create an API token with Object Read & Write on this bucket
# (R2 → Manage R2 API Tokens); the account id is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yiwang-photos

# Public URL of that bucket, no trailing slash: the custom domain once DNS is on Cloudflare,
# or the bucket's r2.dev URL while testing.
IMAGE_BASE=https://img.yiwang.photography

# Cloudflare Pages project (wrangler pages project create <name>). wrangler itself authenticates with
# `npx wrangler login`, or set CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID here for non-interactive use.
PAGES_PROJECT=yiwang-photography
PAGES_BRANCH=main

# on-site.photos import (one-time, until that site is shut down): path to the old photo-location-server .env,
# which holds MONGO_URI and the Cloudflare Images token. Read in place, never copied.
ONSITE_SERVER_ENV=/Users/yiwang/Desktop/workspace/photo-map-projects/photo-location-server/.env

# import-originals: folders (colon-separated) where the exported originals of the gallery photos live. They are
# found by name through Spotlight and confirmed by perceptual hash; only their EXIF is kept, nothing is copied.
ORIGINALS_ROOTS=/Volumes/G-DRIVE PRO/Photography:/Users/yiwang/Library/CloudStorage
